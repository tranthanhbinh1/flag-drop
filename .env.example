# Local secrets for Flag Drop. Copy to .env and fill in.
# Host-side (dagster dev). The compose stack overrides the *_HOST values with in-network names.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=flag-drop
MINIO_SECRET_KEY=changeme
MINIO_RAW_BUCKET=raw
MINIO_RAW_PREFIX=data

DAGSTER_PG_HOST=localhost
DAGSTER_PG_PORT=5432
DAGSTER_PG_DB=dagster
DAGSTER_PG_USER=dagster
DAGSTER_PG_PASSWORD=changeme

# Absolute host path that data/raw symlinks to (mounted at the same path in containers)
RAW_DATA_DIR=/absolute/path/to/raw/tlc/parquet
